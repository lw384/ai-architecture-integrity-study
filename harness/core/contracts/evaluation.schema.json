{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harness Evaluation Result",
  "description": "The standardized output contract for the multi-subject evaluation harness.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic versioning of the schema, e.g., '0.1.0'"
    },
    "run_id": { "type": "string" },
    "trajectory_id": { "type": "string" },
    "task_id": { "type": "string" },
    "rulepack_id": { "type": "string" },
    "target": {
      "type": "object",
      "properties": {
        "workspace_path": { "type": "string" },
        "pre_commit": { "type": "string" },
        "post_commit": { "type": "string" },
        "baseline_commit": { "type": "string" }
      },
      "required": ["workspace_path", "pre_commit", "post_commit", "baseline_commit"]
    },
    "env_snapshot": {
      "type": "object",
      "properties": {
        "node_version": { "type": "string" },
        "pnpm_version": { "type": "string" },
        "harness_commit": { "type": "string" },
        "os": { "type": "string" },
        "tool_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["node_version", "pnpm_version", "harness_commit", "os"]
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constraints": { "$ref": "#/definitions/layer_array" },
        "metrics": { "$ref": "#/definitions/layer_array" },
        "judgments": { "$ref": "#/definitions/layer_array" }
      },
      "required": ["constraints", "metrics", "judgments"]
    },
    "subjects": {
      "type": "array",
      "items": { "$ref": "#/definitions/subject_result" }
    },
    "cross_stack": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/definitions/cross_stack_result" }
      ]
    },
    "task_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_count": { "type": "integer", "minimum": 0 },
        "cross_stack_enabled": { "type": "boolean" },
        "execution": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["subject_count", "cross_stack_enabled", "execution"]
    },
    "deltas": {
      "type": "object",
      "properties": {
        "run_local": { "type": "object", "additionalProperties": true },
        "trajectory_cumulative": { "type": "object", "additionalProperties": true }
      },
      "required": ["run_local", "trajectory_cumulative"]
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["completed", "partial", "failed"]
    },
    "re_evaluated_from": {
      "type": "string",
      "format": "date-time"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "layer": { "type": "string", "enum": ["constraints", "metrics", "judgments", "system"] },
          "name": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["layer", "message"]
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "trajectory_id",
    "task_id",
    "rulepack_id",
    "target",
    "env_snapshot",
    "layers",
    "subjects",
    "cross_stack",
    "task_summary",
    "deltas",
    "duration_ms",
    "status",
    "errors"
  ],
  "definitions": {
    "constraint_finding": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rule_id": { "type": "string" },
        "rule_version": { "type": ["string", "null"] },
        "tier": { "type": ["integer", "null"] },
        "severity": { "type": ["string", "null"] },
        "location": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "message": { "type": "string" },
        "evidence": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      },
      "required": ["message"]
    },
    "constraints_layer_result": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "layer": { "type": "string" },
        "status": { "type": "string", "enum": ["ok", "fail", "error"] },
        "rules_evaluated": { "type": "integer", "minimum": 0 },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/constraint_finding" }
        },
        "findings_by_rule": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/constraint_finding" }
          }
        },
        "background_findings": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "background_by_rule": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          }
        },
        "adapter_meta": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["status", "findings"]
    },
    "metric_or_judgment_result": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "error", "skipped"]
        },
        "findings": { "type": "array", "items": { "type": "string" } },
        "score": {
          "anyOf": [
            { "type": "number" },
            { "type": "object", "additionalProperties": true },
            { "type": "null" }
          ]
        },
        "delta_vs_baseline": {
          "type": ["number", "null"]
        },
        "kappa": {
          "type": ["number", "null"]
        },
        "per_sample_results": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "raw_artifact_path": { "type": "string" }
      },
      "required": ["name", "version", "status", "raw_artifact_path"]
    },
    "subject_layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constraints": { "$ref": "#/definitions/constraints_layer_result" },
        "metrics": {
          "type": "array",
          "items": { "$ref": "#/definitions/metric_or_judgment_result" }
        },
        "judgments": {
          "type": "array",
          "items": { "$ref": "#/definitions/metric_or_judgment_result" }
        }
      },
      "required": ["constraints", "metrics", "judgments"]
    },
    "subject_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_id": { "type": "string" },
        "subject_root": { "type": "string" },
        "rulepack_id": { "type": "string" },
        "rulepack_version": { "type": "string" },
        "adapters": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["completed", "failed", "error"]
        },
        "layers": { "$ref": "#/definitions/subject_layers" }
      },
      "required": [
        "subject_id",
        "subject_root",
        "rulepack_id",
        "rulepack_version",
        "adapters",
        "status",
        "layers"
      ]
    },
    "cross_stack_result": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "plan_id": { "type": "string" },
        "rulepack_id": { "type": "string" },
        "status": { "type": "string", "enum": ["skipped", "completed", "failed", "error"] },
        "reason": { "type": "string" }
      },
      "required": ["plan_id", "rulepack_id", "status"]
    },
    "layer_array": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "error", "skipped"]
          },
          "findings": { "type": "array", "items": { "type": "string" } },
          "score": {
            "anyOf": [
              { "type": "number" },
              { "type": "object", "additionalProperties": true },
              { "type": "null" }
            ]
          },
          "delta_vs_baseline": {
            "type": ["number", "null"]
          },
          "kappa": {
            "type": ["number", "null"]
          },
          "per_sample_results": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": true }
          },
          "raw_artifact_path": { "type": "string" }
        },
        "required": ["name", "version", "status", "raw_artifact_path"]
      }
    }
  }
}