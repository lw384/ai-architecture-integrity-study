{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harness Evaluation Result",
  "description": "Version 0.2 evaluation contract with explicit execution, compliance, and comparison semantics.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "evaluation_profile_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "trajectory_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "rulepack_id": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_path": { "type": "string", "minLength": 1 },
        "pre_commit": { "type": "string", "minLength": 1 },
        "post_commit": { "type": "string", "minLength": 1 },
        "baseline_commit": { "type": "string", "minLength": 1 }
      },
      "required": ["workspace_path", "pre_commit", "post_commit", "baseline_commit"]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["self", "trajectory"] },
        "baseline": { "$ref": "#/definitions/artifact_reference" },
        "pre": { "$ref": "#/definitions/artifact_reference" },
        "post": { "$ref": "#/definitions/artifact_reference" }
      },
      "required": ["mode", "baseline", "pre", "post"]
    },
    "env_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_version": { "type": "string" },
        "pnpm_version": { "type": "string" },
        "harness_commit": { "type": "string" },
        "os": { "type": "string" },
        "tool_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["node_version", "pnpm_version", "harness_commit", "os", "tool_versions"]
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constraints": { "$ref": "#/definitions/layer_array" },
        "metrics": { "$ref": "#/definitions/layer_array" },
        "judgments": { "$ref": "#/definitions/layer_array" }
      },
      "required": ["constraints", "metrics", "judgments"]
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scope_result" }
    },
    "task_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_count": { "type": "integer", "minimum": 1 },
        "scope_types": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "execution": { "type": "object", "additionalProperties": true }
      },
      "required": ["scope_count", "scope_types", "execution"]
    },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_local": { "$ref": "#/definitions/snapshot_delta" },
        "trajectory_cumulative": { "$ref": "#/definitions/snapshot_delta" }
      },
      "required": ["run_local", "trajectory_cumulative"]
    },
    "duration_ms": { "type": "number", "minimum": 0 },
    "execution_status": {
      "type": "string",
      "enum": ["completed", "partial", "failed"]
    },
    "compliance_status": {
      "type": "string",
      "enum": ["passed", "failed", "unknown"]
    },
    "comparison_status": {
      "type": "string",
      "enum": ["valid", "invalid"]
    },
    "re_evaluated_from": { "type": "string", "format": "date-time" },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/definitions/evaluation_error" }
    }
  },
  "required": [
    "schema_version",
    "evaluation_profile_hash",
    "run_id",
    "trajectory_id",
    "task_id",
    "rulepack_id",
    "target",
    "comparison",
    "env_snapshot",
    "layers",
    "scopes",
    "task_summary",
    "deltas",
    "duration_ms",
    "execution_status",
    "compliance_status",
    "comparison_status",
    "errors"
  ],
  "definitions": {
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": ["string", "null"] },
        "sha256": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        },
        "run_id": { "type": "string", "minLength": 1 },
        "post_commit": { "type": "string", "minLength": 1 }
      },
      "required": ["path", "sha256", "run_id", "post_commit"]
    },
    "constraint_finding": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "rule_id": { "type": "string" },
        "rule_version": { "type": ["string", "null"] },
        "tier": { "type": ["integer", "null"] },
        "severity": { "type": ["string", "null"] },
        "location": { "type": ["object", "null"], "additionalProperties": true },
        "message": { "type": "string" },
        "evidence": { "type": ["object", "null"], "additionalProperties": true }
      },
      "required": ["message"]
    },
    "constraints_layer_result": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "layer": { "type": "string" },
        "status": { "type": "string", "enum": ["ok", "fail", "error"] },
        "rules_evaluated": { "type": "integer", "minimum": 0 },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/constraint_finding" }
        },
        "findings_by_rule": { "type": "object", "additionalProperties": true },
        "background_findings": { "type": "array" },
        "background_by_rule": { "type": "object" },
        "adapter_meta": { "type": "object", "additionalProperties": true }
      },
      "required": ["status", "findings"]
    },
    "metric_or_judgment_result": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string", "enum": ["pass", "fail", "error", "skipped"] },
        "findings": { "type": "array", "items": { "type": "string" } },
        "score": {
          "anyOf": [
            { "type": "number" },
            { "type": "object", "additionalProperties": true },
            { "type": "null" }
          ]
        },
        "delta_vs_baseline": { "type": ["number", "null"] },
        "kappa": { "type": ["number", "null"] },
        "per_sample_results": { "type": "array", "items": { "type": "object" } },
        "raw_artifact_path": { "type": "string" }
      },
      "required": ["name", "version", "status", "raw_artifact_path"]
    },
    "scope_layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constraints": { "$ref": "#/definitions/constraints_layer_result" },
        "metrics": {
          "type": "array",
          "items": { "$ref": "#/definitions/metric_or_judgment_result" }
        },
        "judgments": {
          "type": "array",
          "items": { "$ref": "#/definitions/metric_or_judgment_result" }
        }
      },
      "required": ["constraints", "metrics", "judgments"]
    },
    "scope_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope_id": { "type": "string", "minLength": 1 },
        "scope_type": { "type": "string", "enum": ["subject", "cross-stack"] },
        "scope_root": { "type": "string", "minLength": 1 },
        "rulepack_id": { "type": "string" },
        "rulepack_version": { "type": "string" },
        "adapters": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["completed", "failed", "error"] },
        "layers": { "$ref": "#/definitions/scope_layers" }
      },
      "required": [
        "scope_id",
        "scope_type",
        "scope_root",
        "rulepack_id",
        "rulepack_version",
        "adapters",
        "status",
        "layers"
      ]
    },
    "layer_array": {
      "type": "array",
      "items": { "$ref": "#/definitions/metric_or_judgment_result" }
    },
    "comparison_finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "type": "string" },
        "rule_id": { "type": "string" },
        "source_rule_id": { "type": ["string", "null"] },
        "location": { "type": ["object", "null"], "additionalProperties": true },
        "message": { "type": "string" }
      },
      "required": ["scope", "rule_id", "source_rule_id", "location", "message"]
    },
    "constraint_delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before_count": { "type": "integer", "minimum": 0 },
        "after_count": { "type": "integer", "minimum": 0 },
        "introduced_count": { "type": "integer", "minimum": 0 },
        "resolved_count": { "type": "integer", "minimum": 0 },
        "unchanged_count": { "type": "integer", "minimum": 0 },
        "net_change": { "type": "integer" },
        "introduced": {
          "type": "array",
          "items": { "$ref": "#/definitions/comparison_finding" }
        },
        "resolved": {
          "type": "array",
          "items": { "$ref": "#/definitions/comparison_finding" }
        }
      },
      "required": [
        "before_count",
        "after_count",
        "introduced_count",
        "resolved_count",
        "unchanged_count",
        "net_change",
        "introduced",
        "resolved"
      ]
    },
    "score_delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "scope": { "type": "string" },
        "from": { "type": ["number", "null"] },
        "to": { "type": ["number", "null"] },
        "delta": { "type": ["number", "null"] },
        "direction": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["available", "unavailable"] }
      },
      "required": ["key", "name", "scope", "from", "to", "delta", "direction", "status"]
    },
    "snapshot_delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constraints": { "$ref": "#/definitions/constraint_delta" },
        "metrics": { "type": "array", "items": { "$ref": "#/definitions/score_delta" } },
        "judgments": { "type": "array", "items": { "$ref": "#/definitions/score_delta" } }
      },
      "required": ["constraints", "metrics", "judgments"]
    },
    "evaluation_error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layer": { "type": "string", "enum": ["constraints", "metrics", "judgments", "system"] },
        "name": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["layer", "name", "message"]
    }
  }
}
