{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "description": "Static analysis + evaluation pipeline for NestJS/React codebases",
  "type": "module",
  "scripts": {
    "test:constraints": "node --test core/tests/constraint-model.test.mjs core/tests/backend-constraint-fixtures.test.mjs core/tests/frontend-constraint-fixtures.test.mjs core/tests/backend-dep-c002-exemption.test.mjs core/tests/frontend-render-decision-depth-unification.test.mjs",
    "test:metrics": "node --test core/tests/*-metric.test.mjs core/tests/computed-metric-naming.test.mjs core/tests/frontend-metric-registration.test.mjs",
    "test:rulepack-integrity": "node --test core/tests/rulepack-manifest-completeness.test.mjs",
    "test:rules": "npm run test:rulepack-integrity && npm run test:constraints && npm run test:metrics",
    "lint": "find core adapters rulepacks/ts-nestjs-backend rulepacks/js-react-frontend -type f \\( -name '*.mjs' -o -name '*.js' -o -name '*.cjs' \\) -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^16.0.0",
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.18.0",
    "eslint-plugin-import": "^2.32.0"
  }
}
