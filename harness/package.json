{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "description": "Static analysis + evaluation pipeline for NestJS/React codebases",
  "type": "module",
  "scripts": {
    "eval": "node scripts/evaluate.mjs",
    "test": "node --test core/tests/*.test.mjs rulepacks/js-react-frontend/tests/*.test.mjs rulepacks/cross/tests/*.test.mjs",
    "lint": "find core -type f \\( -name '*.mjs' -o -name '*.js' -o -name '*.cjs' \\) -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dependency-cruiser": "^16.0.0",
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.18.0",
    "eslint-plugin-import": "^2.32.0"
  }
}
