# experiment/instruments/agent-images/Dockerfile.claude
FROM node:20-bookworm-slim

# Install essential system tools
# Claude often needs tools such as git, ripgrep (rg), and jq to search and inspect repositories quickly
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    jq \
    ripgrep \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Install Anthropic's official Claude Code CLI globally
RUN npm install -g @anthropic-ai/claude-code@2.1.197 && \
    npm cache clean --force

# Create a non-root user to improve sandbox security
RUN useradd -m -s /bin/bash codex_agent
USER codex_agent

WORKDIR /workspace

# Default command
CMD ["bash"]
